# Docker Compose overrides. Every value has a default in docker-compose.yml,
# so the stack runs with no .env file present. Copy to .env only to change
# credentials or to move a published port that clashes on your machine.

POSTGRES_USER=qbiq
POSTGRES_PASSWORD=qbiq
POSTGRES_DB=qbiq_h
# The NestJS backend's own database, on the same Postgres server. Created
# by the `migrate_js` service, which owns its migration ledger separately.
POSTGRES_DB_JS=qbiq_h_js

# Published host ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=80
VITE_PORT=5173
